# Copie para .env e ajuste se precisar. Todos os valores são SÓ DE DESENVOLVIMENTO.
# O docker-compose já tem estes mesmos padrões; o .env só é necessário para mudar algo.

# Postgres (um servidor, um banco e dois usuários por serviço)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432
TENANT_DB_OWNER_PASSWORD=dev-only-change-me
TENANT_DB_APP_PASSWORD=dev-only-change-me
PERFORMANCE_DB_OWNER_PASSWORD=dev-only-change-me
PERFORMANCE_DB_APP_PASSWORD=dev-only-change-me
RECRUITMENT_DB_OWNER_PASSWORD=dev-only-change-me
RECRUITMENT_DB_APP_PASSWORD=dev-only-change-me
ENGAGEMENT_DB_OWNER_PASSWORD=dev-only-change-me
ENGAGEMENT_DB_APP_PASSWORD=dev-only-change-me
ANALYTICS_DB_OWNER_PASSWORD=dev-only-change-me
ANALYTICS_DB_APP_PASSWORD=dev-only-change-me

# Kafka (KRaft). CLUSTER_ID é um UUID em base64 de 22 caracteres.
KAFKA_CLUSTER_ID=lVp857k5QSG57ZcJB-x0_w
KAFKA_EXTERNAL_PORT=9094

# Keycloak (realm people importado de infra/keycloak/realm-people.json)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
KEYCLOAK_DB_PASSWORD=dev-only-change-me

# Gateway, serviços e ferramentas
GATEWAY_PORT=8000
TENANT_SERVICE_PORT=8081
MAILPIT_UI_PORT=8025
KAFKA_UI_PORT=8090
ADMINER_PORT=8091

# AWS emulada (LocalStack). Credenciais "test" são as do LocalStack, não reais.
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
S3_ASSETS_BUCKET=people-platform-tenant-assets
S3_RESUMES_BUCKET=people-platform-recruitment-resumes

# Observabilidade
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=dev-only-change-me
JAEGER_UI_PORT=16686
