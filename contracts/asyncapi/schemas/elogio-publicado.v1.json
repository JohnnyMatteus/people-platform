{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people-platform.example.com/schemas/elogio-publicado.v1.json",
  "title": "ElogioPublicado v1",
  "description": "Um elogio público foi publicado no feed. Gera pontos de gamificação e contexto para a 1:1.",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "type": "object",
  "properties": {
    "event_type": { "const": "ElogioPublicado" },
    "event_version": { "const": 1 },
    "producer": { "const": "engagement-service" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["praise_id", "from_employee_id", "to_employee_ids", "values"],
      "properties": {
        "praise_id": { "type": "string", "format": "uuid" },
        "from_employee_id": { "type": "string", "format": "uuid" },
        "to_employee_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
