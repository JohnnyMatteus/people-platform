APP_NAME=recruitment-service
APP_ENV=local
APP_KEY=
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Aplicação: usuário sem BYPASSRLS (recruitment_service_app). Migrações: dono do esquema.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=recruitment_service
DB_USERNAME=recruitment_service_app
DB_PASSWORD=dev-only-change-me
DB_MIGRATION_USERNAME=recruitment_service_owner
DB_MIGRATION_PASSWORD=dev-only-change-me

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

OIDC_ISSUER=http://localhost:8180/realms/people
OIDC_JWKS_URL=http://localhost:8180/realms/people/protocol/openid-connect/certs
OIDC_AUDIENCE=people-api

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_RESUMES_BUCKET=people-platform-recruitment-resumes
S3_PRESIGN_ENDPOINT=http://localhost:4566

KAFKA_BROKERS=localhost:9094
KAFKA_RECRUITMENT_TOPIC=people.recruitment.events.v1
